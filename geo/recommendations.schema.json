{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chifral.pages.dev/geo/recommendations.schema.json",
  "title": "GEO Recommendations",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lastReviewed", "platforms"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "platforms": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "evidence", "recommendations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "crawler": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "search": { "type": ["string", "null"] },
              "training": { "type": ["string", "null"] },
              "user": { "type": ["string", "null"] },
              "source": { "type": "string", "pattern": "^https://" }
            }
          },
          "evidence": {
            "enum": ["established", "evidence-supported", "experimental", "speculative"]
          },
          "recommendations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "claim", "action", "validation", "status", "implementation", "sources"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "claim": { "type": "string", "minLength": 1 },
                "action": { "type": "string", "minLength": 1 },
                "validation": { "type": "string", "minLength": 1 },
                "status": {
                  "enum": ["already-covered-by-seo", "actionable", "experimental", "none"]
                },
                "implementation": {
                  "enum": ["none", "content-review", "robots-policy-review", "external-action", "future-review", "code-change"]
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url", "type", "accessed"],
                    "properties": {
                      "url": { "type": "string", "pattern": "^https://" },
                      "type": { "enum": ["first-party", "third-party"] },
                      "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}